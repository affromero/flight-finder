    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node --import tsx --import ./register.mjs src/e2e-test.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "ink": "^7.1.1",
    "ink-select-input": "^6.0.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "thesidedoor-core": "0.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "eslint": "^10.10.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
