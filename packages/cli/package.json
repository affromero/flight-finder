{
  "name": "@flight-finder/cli",
  "version": "0.15.0",
  "private": true,
  "type": "module",
  "bin": {
    "flight-finder-tui": "./dist/index.js",
    "flightfinder-tui": "./dist/index.js"
  },
  "scripts": {
    "dev": "node --import tsx --import ./register.mjs src/index.tsx",
    "build": "tsup",
